<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#161311"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="24dp"
        android:background="#161311">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#e9e1dd"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUMORA"
                android:textColor="#625d5a"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#e9e1dd"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#161311"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp">

            <!-- ── Status banner ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/home_card_bg"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE AUTOMATION"
                    android:textColor="#625d5a"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tv_cadence_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="5s"
                        android:textColor="#e9e1dd"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="cadence cycle"
                        android:textColor="#625d5a"
                        android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/home_pulse_dot"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Applying across home and lock screen"
                        android:textColor="#988f88"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── SECTION: Cycle Interval ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cycle Interval"
                    android:textColor="#e9e1dd"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CADENCE"
                    android:textColor="#625d5a"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/home_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView android:id="@+id/chip_5s" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="6dp" android:text="5 Sec" android:textSize="11sp" android:textStyle="bold" android:background="@drawable/settings_chip_active" />
                    <TextView android:id="@+id/chip_15s" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="6dp" android:text="15 Sec" android:textSize="11sp" android:textColor="#625d5a" android:background="@drawable/settings_chip_inactive" />
                    <TextView android:id="@+id/chip_1m" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:text="1 Min" android:textSize="11sp" android:textColor="#625d5a" android:background="@drawable/settings_chip_inactive" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:weightSum="3">

                    <TextView android:id="@+id/chip_5m" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="6dp" android:text="5 Min" android:textSize="11sp" android:textColor="#625d5a" android:background="@drawable/settings_chip_inactive" />
                    <TextView android:id="@+id/chip_1h" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="6dp" android:text="1 Hour" android:textSize="11sp" android:textColor="#625d5a" android:background="@drawable/settings_chip_inactive" />
                    <View android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" />

                </LinearLayout>

                <!-- Stepper -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/home_empty_bg"
                    android:padding="14dp"
                    android:layout_marginTop="14dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FINE TUNING" android:textColor="#625d5a" android:textSize="9sp" android:letterSpacing="0.1" android:textAllCaps="true" />
                        <TextView android:id="@+id/tv_stepper_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Changes wallpaper every 5 seconds" android:textColor="#e9e1dd" android:textSize="12sp" android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/settings_chip_inactive" android:paddingStart="4dp" android:paddingEnd="4dp">
                        <TextView android:id="@+id/btn_minus" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="−" android:textColor="#988f88" android:textSize="20sp" />
                        <TextView android:id="@+id/tv_stepper_val" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="center" android:text="5s" android:textColor="#e9e1dd" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/btn_plus" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="+" android:textColor="#988f88" android:textSize="20sp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ── SECTION: System & Battery ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="System &amp; Battery"
                    android:textColor="#e9e1dd"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPTIMIZATION"
                    android:textColor="#625d5a"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/home_card_bg"
                android:layout_marginBottom="28dp">

                <!-- Toggle row helper macro — repeated 4 times -->

                <!-- Row 1: Pause on Low Battery -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pause on Low Battery" android:textColor="#e9e1dd" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Halts cycle automatically when power is under 20%" android:textColor="#625d5a" android:textSize="12sp" android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggle_low_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:showText="false"
                        app:track="@drawable/toggle_track_bg" />

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1e1b19" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />

                <!-- Row 2: Pause on Low Power Mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pause during Low Power Mode" android:textColor="#e9e1dd" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Respects system-wide performance safeguards" android:textColor="#625d5a" android:textSize="12sp" android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggle_low_power_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:showText="false"
                        app:track="@drawable/toggle_track_bg" />

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1e1b19" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />

                <!-- Row 3: Shake to Cycle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shake to Cycle Immediately" android:textColor="#e9e1dd" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Uses motion sensors to force next wallpaper in stack" android:textColor="#625d5a" android:textSize="12sp" android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggle_shake"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:showText="false"
                        app:track="@drawable/toggle_track_bg" />

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1e1b19" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />

                <!-- Row 4: Shuffle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shuffle Order" android:textColor="#e9e1dd" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Play photos in random order instead of sequence" android:textColor="#625d5a" android:textSize="12sp" android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggle_shuffle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:showText="false"
                        app:track="@drawable/toggle_track_bg" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── SECTION: Features ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Features"
                    android:textColor="#e9e1dd"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/home_card_bg"
                android:layout_marginBottom="28dp">

                <!-- Schedule row -->
                <LinearLayout
                    android:id="@+id/row_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/home_empty_bg" android:layout_marginEnd="14dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="S" android:textColor="#625d5a" android:textSize="14sp" android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Photo Schedule" android:textColor="#e9e1dd" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Show different photos by time of day" android:textColor="#625d5a" android:textSize="12sp" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#625d5a" android:textSize="22sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── SECTION: Data & Storage ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Data &amp; Storage"
                    android:textColor="#e9e1dd"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL"
                    android:textColor="#625d5a"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/home_card_bg"
                android:layout_marginBottom="28dp">

                <LinearLayout android:id="@+id/row_clear_deck" android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/home_empty_bg" android:layout_marginEnd="14dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="[]" android:textColor="#625d5a" android:textSize="12sp" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active Deck" android:textColor="#e9e1dd" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_deck_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 wallpapers ready" android:textColor="#625d5a" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear" android:textColor="#ffb4ab" android:textSize="11sp" android:letterSpacing="0.06" android:textAllCaps="true" android:background="@drawable/settings_clear_btn_bg" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1e1b19" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />

                <LinearLayout android:id="@+id/row_reset_splash" android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/home_empty_bg" android:layout_marginEnd="14dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="i" android:textColor="#625d5a" android:textSize="14sp" android:textStyle="bold" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Show intro again" android:textColor="#e9e1dd" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reset onboarding screen" android:textColor="#625d5a" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reset" android:textColor="#988f88" android:textSize="11sp" android:letterSpacing="0.06" android:textAllCaps="true" android:background="@drawable/settings_reset_btn_bg" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- ── SECTION: About ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="About" android:textColor="#e9e1dd" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="APP" android:textColor="#625d5a" android:textSize="10sp" android:letterSpacing="0.1" android:textAllCaps="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/home_card_bg"
                android:layout_marginBottom="28dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/home_empty_bg" android:layout_marginEnd="14dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="v" android:textColor="#625d5a" android:textSize="14sp" android:textStyle="bold"/></FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Version" android:textColor="#e9e1dd" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lumora v1.0.0" android:textColor="#625d5a" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1e1b19" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/home_empty_bg" android:layout_marginEnd="14dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="A" android:textColor="#625d5a" android:textSize="14sp" android:textStyle="bold"/></FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Developer" android:textColor="#e9e1dd" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Abhinav · abhinav3254" android:textColor="#625d5a" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1e1b19" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"/>

                <LinearLayout android:id="@+id/row_share" android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/home_empty_bg" android:layout_marginEnd="14dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="&lt;" android:textColor="#625d5a" android:textSize="14sp" android:textStyle="bold"/></FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share Lumora" android:textColor="#e9e1dd" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tell a friend about the app" android:textColor="#625d5a" android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#625d5a" android:textSize="22sp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Save -->
            <TextView
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="SAVE PREFERENCES"
                android:textColor="#33302d"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/splash_btn_primary_bg" />

            <TextView
                android:id="@+id/tv_save_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Settings saved"
                android:textColor="#ccc5c1"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Lumora · Made with care"
                android:textColor="#2d2927"
                android:textSize="11sp"
                android:layout_marginTop="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
