<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#161311"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="24dp"
        android:background="#161311">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#e9e1dd"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUMORA"
                android:textColor="#625d5a"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photo Schedule"
                android:textColor="#e9e1dd"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Enable schedule toggle -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/toggle_schedule_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:showText="false"
            android:thumb="@null"
            app:track="@drawable/toggle_track_bg" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#161311"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp">

            <!-- Info card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/home_card_bg"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOW IT WORKS"
                    android:textColor="#625d5a"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Each slot defines a time window and the photos that cycle during that window. Enable the schedule toggle above to activate it."
                    android:textColor="#988f88"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.5" />

            </LinearLayout>

            <!-- Slot list container — slots added here dynamically -->
            <LinearLayout
                android:id="@+id/container_slots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Add slot button -->
            <LinearLayout
                android:id="@+id/btn_add_slot"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/home_empty_bg"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="#ccc5c1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add new slot"
                    android:textColor="#ccc5c1"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Save -->
            <TextView
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="SAVE SCHEDULE"
                android:textColor="#33302d"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/splash_btn_primary_bg"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tv_save_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Schedule saved"
                android:textColor="#ccc5c1"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
